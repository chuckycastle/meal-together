{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mealtogether",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // The Worker handles every request: the API, pages (per-request nonce), and
    // files, so a missing file gets a 404 instead of the app shell.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "mealtogether.chuckycastle.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mealtogether",
      "database_id": "35be6613-cf0c-4009-8d47-db75a15320cb",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-in, sign-up, and password changes: 10 per minute per address and route
  "ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "1301", "simple": { "limit": 10, "period": 60 } }],
  // Token signing key is a secret: `wrangler secret put JWT_SECRET`
  "observability": { "enabled": true }
}
