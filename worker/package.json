{
  "name": "mealtogether-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "cd ../frontend && npm run build:cloudflare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply mealtogether --local",
    "migrate:remote": "wrangler d1 migrations apply mealtogether --remote",
    "deploy": "npm run typecheck && npm test && npm run build:frontend && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.9",
    "wrangler": "^4.152.0"
  }
}
